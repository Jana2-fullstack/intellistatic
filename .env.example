APP_NAME=IntelliStatic
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./intellistatic.db
MODEL_DIR=./ml_training/models
BINARY_MODEL_FILE=lgbm_binary.txt
MULTICLASS_MODEL_FILE=lgbm_multiclass.txt
SCALER_FILE=scaler.pkl

MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=.exe,.dll,.sys,.bin
YARA_RULES_DIR=./yara_rules
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Requests per minute per client to POST /api/v1/analyze* (0 disables).
RATE_LIMIT_PER_MINUTE=30

# Server-side API key. Copy .env.example to .env and generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# run_local.py passes it to the dashboard automatically (INTELLISTATIC_API_KEY).
# API_KEY=replace-with-a-long-random-secret
